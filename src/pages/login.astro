---
import AuthLayout from '../layouts/AuthLayout.astro';
import '../styles/auth.css';
import { SITE } from '../data/site';
---
<AuthLayout title="Sign in" description="Wraith accounts are Scooby accounts. Sign in on the Scooby portal.">
  <script is:inline define:vars={{ target: SITE.scoobyLogin }}>
    try {
      location.replace(localStorage.getItem('portalSessionToken') ? '/dashboard' : target);
    } catch {
      location.replace(target);
    }
  </script>
  <noscript><meta http-equiv="refresh" content={`0; url=${SITE.scoobyLogin}`} /></noscript>

  <header class="auth-head">
    <div class="spinner" aria-hidden="true"></div>
    <p class="eyebrow">Welcome back</p>
    <h1 class="display">Taking you to <em>Scooby</em>.</h1>
    <p>Wraith accounts are Scooby accounts. Sign in on the Scooby portal to manage your license.</p>
  </header>

  <a href={SITE.scoobyLogin} class="btn btn--primary btn--full">Continue to Scooby sign in →</a>
  <p class="auth-alt">No Scooby account yet? <a href={SITE.scoobyRegister}>Create one →</a></p>
</AuthLayout>
