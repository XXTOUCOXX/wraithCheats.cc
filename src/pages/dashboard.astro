---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import { SITE } from '../data/site';
import { CURRENT_VERSION } from '../data/changelog';
---
<BaseLayout title="Dashboard" description="Your Wraith license, keys and account." footer={false} preloadArt="hero">
  <script is:inline>
    try { if (!localStorage.getItem('portalSessionToken')) location.replace('/login'); } catch {}
  </script>

  <Scene art="hero" focus="80% 60%" size="head" kenburns={false} class="dash-head">
    <div class="who">
      <div class="pfp" id="pfp-wrap">
        <img id="dash-pfp" src="/assets/wraith-icon.png" alt="Profile picture" width="72" height="72" />
        <button id="pfp-edit-btn" class="pfp__edit" type="button" aria-label="Change profile picture" aria-controls="pfp-popup">✎</button>
        <div id="pfp-popup" class="pfp__popup panel" hidden>
          <label class="field__label" for="pfp-url-input">Image URL</label>
          <input id="pfp-url-input" class="field__input" type="url" placeholder="https://…" />
          <div class="pfp__btns">
            <button id="pfp-save-btn" type="button" class="btn btn--primary">Save</button>
            <button id="pfp-cancel-btn" type="button" class="btn btn--ghost">Cancel</button>
          </div>
        </div>
      </div>
      <div>
        <p class="eyebrow">Welcome back, rider</p>
        <h1 class="display h-lg" id="dash-name">—</h1>
        <p class="who__meta"><span id="dash-member">Member</span> · <span id="dash-joined">—</span></p>
      </div>
    </div>
  </Scene>

  <section class="wrap dash">
    <div class="dash__main">
      <article class="card license">
        <header class="card__head">
          <p class="eyebrow">License</p>
          <span class="chip chip--blood" id="dash-tier-badge">—</span>
        </header>
        <h2 class="display h-md">You own <em>Wraith</em>.</h2>
        <p class="license__status" id="dash-status">
          Status may take a few minutes to update after redeeming a key. Please be patient.
        </p>
        <dl class="license__info">
          <div><dt>Tier</dt><dd id="dash-tier">—</dd></div>
          <div><dt>Activated</dt><dd id="dash-activated">—</dd></div>
          <div><dt>Expires</dt><dd id="dash-expires">—</dd></div>
        </dl>
      </article>

      <article class="card">
        <header class="card__head"><p class="eyebrow">Redeem a key</p></header>
        <h2 class="display h-md">Got another <em>key</em>?</h2>
        <p class="card__text">Add licenses, gift codes or promo keys. They attach instantly and unlock any extra perks they carry.</p>
        <form class="redeem" id="redeem-form">
          <label class="sr-only" for="redeem-input">License key</label>
          <input class="field__input" type="text" id="redeem-input" placeholder="WRTH-XXXX-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" required />
          <button type="submit" class="btn btn--primary">Redeem →</button>
        </form>
      </article>
    </div>

    <aside class="dash__side">
      <div class="stats">
        <div class="stat"><span class="stat__num" id="stat-build">v{CURRENT_VERSION}</span><span class="stat__label">Latest build</span></div>
        <div class="stat"><span class="stat__num" id="stat-days">∞</span><span class="stat__label">Days remaining</span></div>
      </div>
      <nav class="card actions" aria-label="Quick actions">
        <p class="eyebrow">Quick actions</p>
        <a href="/setup">Install guide <span>›</span></a>
        <a href="/changelog">What's new <span>›</span></a>
        <a href={SITE.discord} target="_blank" rel="noopener">Support on Discord <span>›</span></a>
        <a href="#" data-logout class="actions__logout">Log out <span>›</span></a>
      </nav>
    </aside>
  </section>
</BaseLayout>

<script>
  import { initDashboard } from '../scripts/portal';
  initDashboard();
</script>

<style>
  .who { display: flex; align-items: center; gap: 24px; }
  .who .eyebrow { margin: 0 0 12px; }
  .who h1 { overflow-wrap: anywhere; }
  .who__meta { margin: 12px 0 0; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bone-mute); }

  .pfp { position: relative; flex: none; }
  .pfp > img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--blood);
    background: var(--ink);
  }
  .pfp__edit {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--night);
    background: var(--blood);
    cursor: pointer;
    font-size: 13px;
  }
  .pfp__popup {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 0;
    z-index: 10;
    width: min(300px, calc(100vw - 32px));
    padding: 16px;
    display: grid;
    gap: 10px;
    background: var(--night-2);
  }
  .pfp__popup[hidden] { display: none; }
  .pfp__btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .pfp__btns .btn { min-height: 40px; padding: 8px 12px 6px; font-size: 1rem; }

  .dash {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 24px;
    padding-block: 32px clamp(64px, 8vw, 120px);
  }
  .dash__main, .dash__side { display: grid; gap: 24px; align-content: start; }
  .card {
    padding: clamp(24px, 3.5vw, 36px);
    background: linear-gradient(180deg, rgba(23, 29, 42, 0.75), rgba(14, 17, 25, 0.85));
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .card__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; }
  .card__head .eyebrow { margin: 0; }
  .card h2 { margin: 0 0 14px; }
  .card__text { margin: 0 0 22px; color: var(--bone-dim); max-width: 52ch; }

  .license__status {
    margin: 0 0 26px;
    padding: 12px 16px;
    border-left: 2px solid var(--ember);
    background: rgba(227, 154, 76, 0.06);
    color: var(--bone-dim);
    font-size: 14px;
  }
  :global(body[data-license='active']) .license__status { border-color: #6fbf73; background: rgba(111, 191, 115, 0.07); }
  .license__info { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .license__info div { padding-top: 14px; border-top: 1px solid var(--line); }
  .license__info dt { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bone-mute); }
  .license__info dd { margin: 6px 0 0; font: 400 1.6rem/1.1 var(--f-display); letter-spacing: 0.04em; }

  .redeem { display: flex; gap: 10px; }
  .redeem input { font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; }
  .redeem .btn { flex: none; }

  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .stat {
    display: grid;
    gap: 6px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--night-2);
  }
  .stat__num { font: 400 2.4rem/1 var(--f-display); }
  .stat__label { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-mute); }

  .actions { display: grid; gap: 4px; }
  .actions .eyebrow { margin: 0 0 12px; }
  .actions a {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--bone-dim);
    text-decoration: none;
    transition: color 0.2s, padding 0.2s;
  }
  .actions a:hover { color: var(--bone); padding-left: 6px; }
  .actions a span { color: var(--ember); }
  .actions__logout { border-bottom: 0 !important; }
  .actions__logout:hover { color: var(--blood-hi) !important; }

  @media (max-width: 900px) {
    .dash { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .who { flex-direction: column; align-items: flex-start; gap: 18px; }
    .license__info { grid-template-columns: 1fr; }
    .redeem { flex-direction: column; }
  }
</style>
