---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import { RELEASES, formatDate, type ChangeKind } from '../data/changelog';

const LABELS: Record<ChangeKind, string> = { added: 'Added', changed: 'Changed', fixed: 'Fixed', removed: 'Removed' };
const ORDER: ChangeKind[] = ['added', 'changed', 'fixed', 'removed'];
---
<BaseLayout
  title="Changelog"
  description="Every Wraith release since launch. Updates auto-deliver to active licenses."
  preloadArt="land"
>
  <Scene art="land" focus="70% 60%" size="head" eager>
    <p class="eyebrow" data-reveal>Release log</p>
    <h1 class="display h-xl" data-reveal style="--d:.1s">Change<em>log</em>.</h1>
    <p class="lead" data-reveal style="--d:.2s">Every shot fired since launch. Updates auto-deliver to active licenses.</p>
  </Scene>

  <section class="wrap log">
    {RELEASES.map((r, i) => (
      <article class="rel" id={`v${r.version}`} data-reveal>
        <header class="rel__meta">
          <a href={`#v${r.version}`} class="rel__ver">v{r.version}</a>
          <div class="rel__tags">
            {i === 0 && <span class="chip chip--blood"><span class="dot"></span>Latest</span>}
            <span class="chip">{r.type}</span>
          </div>
          <time datetime={r.date}>{formatDate(r.date)}</time>
        </header>
        <div class="rel__body">
          <h2 class="display h-sm">{r.summary}</h2>
          {ORDER.filter((k) => r.changes[k]?.length).map((k) => (
            <div class={`rel__group is-${k}`}>
              <p class="rel__label">{LABELS[k]}</p>
              <ul>{r.changes[k]!.map((c) => <li>{c}</li>)}</ul>
            </div>
          ))}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .log { padding-block: 40px clamp(80px, 10vw, 140px); }
  .rel {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 24px 56px;
    padding-block: 48px;
    border-bottom: 1px solid var(--line);
  }
  .rel:first-child { padding-top: 16px; }
  .rel__meta { position: sticky; top: calc(var(--nav-h) + 24px); align-self: start; display: grid; gap: 12px; }
  .rel__ver {
    font: 400 3.4rem/0.9 var(--f-display);
    color: var(--bone);
    text-decoration: none;
  }
  .rel__tags { display: flex; gap: 8px; flex-wrap: wrap; }
  time { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bone-mute); }
  .rel__body h2 { margin: 0 0 24px; color: var(--bone); }
  .rel__group { margin-bottom: 22px; }
  .rel__label {
    margin: 0 0 10px;
    font: 600 11px/1 var(--f-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .is-added .rel__label { color: var(--ember); }
  .is-changed .rel__label { color: var(--moon); }
  .is-fixed .rel__label { color: #8fbf8a; }
  .is-removed .rel__label { color: var(--blood-hi); }
  .rel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .rel li { position: relative; padding-left: 20px; color: var(--bone-dim); font-size: 15px; max-width: 75ch; }
  .rel li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 8px; height: 1px; background: var(--bone-mute); }

  @media (max-width: 760px) {
    .rel { grid-template-columns: 1fr; gap: 16px; }
    .rel__meta { position: static; grid-template-columns: auto 1fr; align-items: center; }
    .rel__meta time { grid-column: 1 / -1; }
  }
</style>
