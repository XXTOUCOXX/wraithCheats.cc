---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import Chapter from '../components/Chapter.astro';
import TierCard from '../components/TierCard.astro';
import { CHAPTERS, STEPS } from '../data/chapters';
import { TIERS } from '../data/tiers';
import { FAQ } from '../data/faq';
import { SITE } from '../data/site';
---
<BaseLayout preloadArt="hero">
  <!-- HERO -->
  <Scene art="hero" focus="80% 60%" eager letterbox parallax={90} class="hero">
    <div class="hero__body">
      <a href={SITE.scooby} target="_blank" rel="noopener" class="chip chip--fire hero__chip" data-reveal>
        <span class="dot"></span>Requires Scooby Menu
      </a>
      <h1 class="display hero__title" data-reveal style="--d:.1s">Wraith</h1>
      <p class="serif hero__tag" data-reveal style="--d:.2s">{SITE.tagline}</p>
      <p class="lead" data-reveal style="--d:.3s">
        A frontier-grade Lua extension for RedM. One key opens a deep menu of player tools, aim, ESP,
        world controls and every model in the game.
      </p>
      <div class="hero__ctas" data-reveal style="--d:.4s">
        <a href="/buy" class="btn btn--primary">Get a license</a>
        <a href="#watch" class="btn btn--ghost">▶&nbsp; Watch it ride</a>
      </div>
    </div>
    <a href="#chapters" class="hero__scroll" aria-label="Scroll to features"><span></span></a>
  </Scene>

  <!-- PROLOGUE -->
  <section class="prologue wrap section--tight" id="chapters">
    <p class="eyebrow" data-reveal>Five chapters</p>
    <p class="display h-md prologue__line" data-reveal style="--d:.1s">
      Hundreds of tools. <em>One</em> menu.<br />Built to feel like the game it rides in.
    </p>
    <ol class="prologue__index" data-reveal style="--d:.2s">
      {CHAPTERS.map((c) => (
        <li><a href={`#${c.id}`}><span>{c.numeral}</span>{c.kicker}</a></li>
      ))}
    </ol>
  </section>

  {CHAPTERS.map((c) => <Chapter chapter={c} />)}

  <!-- WATCH -->
  <section class="watch section" id="watch">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow" data-reveal>In-game</p>
        <h2 class="display h-lg" data-reveal style="--d:.1s">See it <em>ride</em>.</h2>
        <p class="lead" data-reveal style="--d:.2s">Distressed paper, blood-red headers, brushed panels. The Wraith menu lives inside the world it controls.</p>
      </header>
      <div class="watch__grid">
        <figure class="watch__menu" data-reveal>
          <img src="/assets/wraith-menu.png" alt="The Wraith Platinum main menu in-game" width="600" height="704" loading="lazy" />
        </figure>
        <div class="watch__video" data-reveal style="--d:.15s">
          <button class="yt" data-yt={SITE.youtubeId} aria-label="Play the Wraith showcase video">
            <img src={`https://i.ytimg.com/vi/${SITE.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
            <span class="yt__play" aria-hidden="true"></span>
            <span class="yt__label">Showcase · YouTube</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- TIERS -->
  <section class="section tiers" id="pricing">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow" data-reveal>Two tiers · one-time</p>
        <h2 class="display h-lg" data-reveal style="--d:.1s">Pick your <em>iron</em>.</h2>
        <p class="lead" data-reveal style="--d:.2s">Pay once, ride forever. Lifetime updates included, key delivered instantly.</p>
      </header>
      <div class="tiers__grid">
        {TIERS.map((t) => <TierCard tier={t} />)}
      </div>
      <p class="tiers__more" data-reveal><a href="/buy#compare" class="link-arrow">Compare every feature →</a></p>
    </div>
  </section>

  <!-- STEPS -->
  <section class="section steps" id="install">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow" data-reveal>Install</p>
        <h2 class="display h-lg" data-reveal style="--d:.1s">Four steps. <em>One key.</em></h2>
      </header>
      <ol class="steps__list">
        {STEPS.map((s, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <span class="steps__num">0{i + 1}</span>
            <h3 class="display h-sm">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p data-reveal><a href="/setup" class="link-arrow">Read the full install guide →</a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="wrap faq__wrap">
      <header class="section-head">
        <p class="eyebrow" data-reveal>FAQ</p>
        <h2 class="display h-lg" data-reveal style="--d:.1s">Questions <em>at the fire</em>.</h2>
      </header>
      <div class="faq__list" data-reveal>
        {FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINALE -->
  <Scene art="cta" focus="72% 55%" class="finale">
    <div class="finale__body">
      <h2 class="display h-xl" data-reveal>Ride out<br />with <em>Wraith</em>.</h2>
      <p class="serif finale__tag" data-reveal style="--d:.1s">Licensed per rider. Key-activated. Locked tight.</p>
      <div class="hero__ctas finale__ctas" data-reveal style="--d:.2s">
        <a href="/buy" class="btn btn--primary">Get a license</a>
        <a href={SITE.scoobyLogin} class="btn btn--ghost">Sign in</a>
      </div>
    </div>
  </Scene>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = 'Wraith in-game showcase';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>

<style>
  /* hero */
  .hero__body { max-width: 620px; }
  .hero__chip { text-decoration: none; margin-bottom: 26px; }
  .hero__title {
    font-size: clamp(5.5rem, 19vw, 15rem);
    letter-spacing: 0.06em;
    line-height: 0.82;
    text-shadow: 0 10px 60px rgba(0, 0, 0, 0.6);
  }
  .hero__tag {
    margin: 10px 0 22px;
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    color: var(--bone);
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: calc(7vh + 18px);
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    z-index: 2;
  }
  .hero__scroll span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 2px;
    height: 8px;
    margin-left: -1px;
    background: var(--bone);
    border-radius: 2px;
    animation: scrolldot 2s var(--ease) infinite;
  }
  @keyframes scrolldot {
    0% { transform: translateY(0); opacity: 1; }
    80% { transform: translateY(14px); opacity: 0; }
    100% { opacity: 0; }
  }

  /* prologue */
  .prologue { text-align: center; display: grid; justify-items: center; gap: 26px; }
  .prologue__line { max-width: 18ch; color: var(--bone); }
  .prologue__index {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
  }
  .prologue__index a {
    display: inline-flex;
    gap: 10px;
    align-items: baseline;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    color: var(--bone-dim);
    transition: border-color 0.2s, color 0.2s;
  }
  .prologue__index a:hover { border-color: var(--ember); color: var(--bone); }
  .prologue__index span { font: 400 1.1rem/1 var(--f-display); color: var(--ember); }

  /* watch */
  .watch { background: linear-gradient(180deg, var(--night) 0%, var(--night-2) 100%); }
  .watch__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .watch__menu {
    margin: 0;
    padding: 14px;
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 8px;
    transform: rotate(-1.5deg);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .watch__menu img { width: 100%; height: auto; border-radius: 4px; }
  .watch__video :is(.yt, iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--ink);
  }
  .yt { position: relative; padding: 0; cursor: pointer; }
  .yt img { width: 100%; height: 100%; object-fit: cover; opacity: 0.75; transition: opacity 0.3s, transform 0.6s var(--ease); }
  .yt:hover img { opacity: 0.95; transform: scale(1.03); }
  .yt__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    border-radius: 50%;
    background: var(--blood);
    box-shadow: 0 0 0 10px rgba(179, 38, 43, 0.25), 0 20px 50px rgba(0, 0, 0, 0.6);
  }
  .yt__play::after {
    content: '';
    position: absolute;
    left: 34px;
    top: 26px;
    border-left: 22px solid var(--bone);
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
  }
  .yt__label {
    position: absolute;
    left: 18px;
    bottom: 14px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }

  /* tiers */
  .tiers { background: var(--night-2); }
  .tiers__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 920px;
  }
  .tiers__more { margin-top: 32px; }

  /* steps */
  .steps__list {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .steps__list li {
    padding: 28px 24px 8px 0;
    border-right: 1px solid var(--line);
    margin-right: 24px;
  }
  .steps__list li:last-child { border-right: 0; margin-right: 0; }
  .steps__num { font: 400 1.1rem/1 var(--f-display); color: var(--ember); letter-spacing: 0.12em; }
  .steps__list h3 { margin: 14px 0 10px; }
  .steps__list p { margin: 0; color: var(--bone-dim); font-size: 15px; }

  /* faq */
  .faq { background: var(--night-2); border-top: 1px solid var(--line); }
  .faq__wrap { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 48px; }
  .faq__list { border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 40px 22px 0;
    position: relative;
    font-size: 1.05rem;
    font-weight: 500;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font: 400 1.8rem/1 var(--f-display);
    color: var(--ember);
    transition: transform 0.3s var(--ease);
  }
  .faq details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq details p { margin: 0 0 24px; color: var(--bone-dim); max-width: 60ch; }

  /* finale */
  .finale__body { max-width: 640px; }
  .finale__tag { font-size: clamp(1.3rem, 2.4vw, 1.9rem); margin: 22px 0 0; color: var(--bone); }

  @media (max-width: 900px) {
    .watch__grid { grid-template-columns: 1fr; }
    .watch__menu { max-width: 380px; justify-self: center; }
    .steps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps__list li:nth-child(2) { border-right: 0; margin-right: 0; }
    .faq__wrap { grid-template-columns: 1fr; gap: 0; }
  }
  /* phones: keep the campfire visible above the stacked headline */
  @media (max-width: 700px) {
    :global(.hero .scene__media) { bottom: 36svh; }
    :global(.hero .scene__media img) { object-position: 50% 78%; }
    :global(.hero .scene__shade) {
      background: linear-gradient(0deg, var(--night) 0%, var(--night) 34svh, rgba(11, 13, 19, 0.55) 46svh, transparent 62svh) !important;
    }
  }
  @media (max-width: 640px) {
    .tiers__grid { grid-template-columns: 1fr; }
    .steps__list { grid-template-columns: 1fr; }
    .steps__list li { border-right: 0; margin-right: 0; border-bottom: 1px solid var(--line); padding-bottom: 24px; }
    .hero__scroll { display: none; }
  }
</style>
