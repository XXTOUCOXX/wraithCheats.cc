---
import type { Tier } from '../data/tiers';

interface Props {
  tier: Tier;
  /** 'teaser' shows highlights; 'full' shows every feature group */
  variant?: 'teaser' | 'full';
}
const { tier: t, variant = 'teaser' } = Astro.props;
---
<article class:list={['tier', `tier--${t.id}`, { 'tier--featured': t.featured }]} data-reveal>
  {t.featured && <span class="tier__ribbon">Recommended</span>}
  <header>
    <p class="tier__name">{t.name}</p>
    <p class="tier__price"><span>$</span>{t.price}</p>
    <p class="tier__per">{t.per}</p>
  </header>
  <p class="tier__pitch">{t.pitch}</p>

  {variant === 'teaser' ? (
    <ul class="tier__list">
      {t.highlights.map((h) => <li>{h}</li>)}
    </ul>
  ) : (
    <div class="tier__groups">
      {t.groups.map((g) => (
        <div class:list={['tier__group', { 'is-exclusive': g.exclusive }]}>
          <p class="tier__group-label">{g.label}{g.exclusive && <span> · Platinum</span>}</p>
          <ul class="tier__list">{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
      {t.notIncluded && (
        <div class="tier__group is-locked">
          <p class="tier__group-label">Not included</p>
          <ul class="tier__list">{t.notIncluded.map((i) => <li>{i}</li>)}</ul>
        </div>
      )}
    </div>
  )}

  {variant === 'teaser' ? (
    <a href="/buy" class:list={['btn', t.featured ? 'btn--primary' : 'btn--ghost', 'btn--full']}>Choose {t.name} →</a>
  ) : (
    <a href={t.checkout} class:list={['btn', t.featured ? 'btn--primary' : 'btn--ghost', 'btn--full']} data-checkout={t.id}>
      Buy {t.name} · ${t.price} →
    </a>
  )}
</article>

<style>
  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(28px, 4vw, 40px);
    background: linear-gradient(180deg, rgba(23, 29, 42, 0.82), rgba(12, 15, 22, 0.9));
    border: 1px solid var(--line);
    border-radius: 8px;
    backdrop-filter: blur(8px);
  }
  .tier--featured {
    border-color: rgba(210, 58, 63, 0.55);
    box-shadow: 0 0 0 1px rgba(210, 58, 63, 0.15), 0 40px 80px -40px rgba(179, 38, 43, 0.55);
  }
  .tier__ribbon {
    position: absolute;
    top: -12px;
    right: 24px;
    padding: 6px 12px 4px;
    background: var(--blood);
    border-radius: var(--radius);
    font: 400 0.95rem/1 var(--f-display);
    letter-spacing: 0.14em;
  }
  header { display: grid; gap: 6px; }
  .tier__name {
    margin: 0;
    font: 400 2.2rem/1 var(--f-display);
    letter-spacing: 0.08em;
  }
  .tier--platinum .tier__name { color: #cfdbe6; }
  .tier--elite .tier__name { color: var(--ember); }
  .tier__price {
    margin: 8px 0 0;
    font: 400 clamp(4rem, 7vw, 5.4rem)/0.9 var(--f-display);
  }
  .tier__price span {
    font-size: 0.45em;
    vertical-align: top;
    margin-right: 4px;
    color: var(--bone-dim);
  }
  .tier__per {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone-mute);
  }
  .tier__pitch { margin: 0; color: var(--bone-dim); font-size: 15px; }
  .tier__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .tier__list li {
    position: relative;
    padding-left: 26px;
    font-size: 14.5px;
    color: var(--bone);
  }
  .tier__list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--ember);
    font-weight: 600;
  }
  .tier__groups { display: grid; gap: 20px; align-content: start; flex: 1; }
  .tier__group-label {
    margin: 0 0 10px;
    font: 600 11px/1 var(--f-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-mute);
  }
  .tier__group-label span { color: var(--blood-hi); }
  .is-exclusive .tier__list li::before { color: var(--blood-hi); }
  .is-locked .tier__list li { color: var(--bone-mute); text-decoration: line-through; text-decoration-color: rgba(122, 116, 104, 0.6); }
  .is-locked .tier__list li::before { content: '–'; color: var(--bone-mute); }
  .btn { margin-top: auto; }
</style>
